{
  "name": "dzbanek-bot",
  "version": "2.0.0",
  "description": "Discord bot with a YouTube/Spotify music player and automated Steam + Epic game deals.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "deploy": "tsx src/deploy-commands.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.2",
    "@snazzah/davey": "^0.1.12",
    "@prisma/client": "^5.22.0",
    "croner": "^10.0.1",
    "discord.js": "^14.26.4",
    "libsodium-wrappers": "^0.8.4",
    "rss-parser": "^3.13.0",
    "youtube-dl-exec": "^3.1.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.3",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "prisma": "^5.22.0",
    "prettier": "^3.8.4",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.0"
  },
  "allowScripts": {
    "youtube-dl-exec@3.1.15": true,
    "@discordjs/opus@0.10.0": true,
    "esbuild@0.28.2": true,
    "@prisma/client@5.22.0": true,
    "prisma@5.22.0": true,
    "@prisma/engines@5.22.0": true
  }
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

/// Posted Steam deal IDs / Epic lineup fingerprints, scoped per guild.
model DedupEntry {
  id        Int      @id @default(autoincrement())
  scope     String
  itemId    String
  createdAt DateTime @default(now())

  @@unique([scope, itemId])
  @@index([scope])
  @@index([scope, createdAt])
}

/// Per-server Steam / Epic / greetings / kitchen channel settings.
model GuildSettings {
  guildId              String   @id
  steamEnabled         Boolean  @default(true)
  steamChannelId       String?
  epicEnabled          Boolean  @default(true)
  epicChannelId        String?
  welcomeEnabled       Boolean  @default(true)
  welcomeChannelId     String?
  goodbyeEnabled       Boolean  @default(true)
  goodbyeChannelId     String?
  kitchenEnabled       Boolean  @default(true)
  kitchenChannelId     String?
  kitchenMessageId     String?
  kitchenJoinDate      String?
  kitchenJoinCount     Int      @default(0)
  radioNightEnabled    Boolean  @default(false)
  radioNightChannelId  String?
  radioNightStation    String?
  lastRadioStation     String?
  /// Voice channel playing radio. Cleared on /radio stop. Used to rejoin after a restart.
  lastRadioChannelId   String?
  idleRadioEnabled     Boolean  @default(true)
  /// Where Wishlist Radar posts. Null falls back to config, then the Steam channel.
  wishlistChannelId    String?
  updatedAt            DateTime @updatedAt
}

/// One Radio Night vote per member per Friday (Europe/Prague week key).
model RadioNightVote {
  id        Int      @id @default(autoincrement())
  guildId   String
  weekKey   String
  userId    String
  stationId String
  updatedAt DateTime @updatedAt

  @@unique([guildId, weekKey, userId])
  @@index([guildId, weekKey])
}

/// A song a member caught off live radio. One row per person per track.
model RadioCatch {
  id        Int      @id @default(autoincrement())
  guildId   String
  userId    String
  stationId String
  artist    String
  title     String
  artistKey String
  titleKey  String
  coverUrl  String?
  caughtAt  DateTime @default(now())

  @@unique([guildId, userId, artistKey, titleKey])
  @@index([guildId, caughtAt])
  @@index([guildId, userId, caughtAt])
}

/// A member's Steam profile, for Wishlist Radar. One per Discord user, shared by every server.
model SteamLink {
  userId   String   @id
  steamId  String
  linkedAt DateTime @default(now())
}

/// A track that started playing, per server: the default song pool for Kitchen Quiz.
model PlayedTrack {
  id            Int      @id @default(autoincrement())
  guildId       String
  url           String
  title         String
  uploader      String?
  thumbnail     String?
  durationSec   Int      @default(0)
  requestedById String?
  playedAt      DateTime @default(now())

  @@unique([guildId, url])
  @@index([guildId, playedAt])
}

/// One player's result in one Kitchen Quiz game.
model QuizScore {
  id       Int      @id @default(autoincrement())
  guildId  String
  userId   String
  score    Int
  correct  Int
  rounds   Int
  playedAt DateTime @default(now())

  @@index([guildId, playedAt])
}
